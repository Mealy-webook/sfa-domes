# Payments run in TEST MODE (built-in test page, no money moves) unless PAYMENT_MODE=paytabs and both keys are set.
PAYMENT_MODE=test

# Copy to .env (same folder) and fill in from PayTabs merchant dashboard → Developers → Key management.
# Use your TEST profile and TEST server key. .env is never served to the browser.
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
# Saudi region endpoint
PAYTABS_BASE_URL=https://secure.paytabs.sa
# Optional: a public https URL for this server (e.g. a tunnel), so PayTabs can also send its server-to-server callback
PUBLIC_URL=
